
# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://your-domain.com

# ── Auth Secrets ──────────────────────────────────────────────────────────────
JWT_SECRET=
COOKIE_SECRET=

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Service name "postgres" is the DNS name inside the Docker network
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=survey_db

DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/survey_db?schema=public

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Rate Limiting (vote endpoint) ─────────────────────────────────────────────
RATE_LIMIT_VOTES=5
RATE_LIMIT_WINDOW_S=60

# ── Message Encryption (AES-256-GCM) ─────────────────────────────────────────
# Must be exactly 64 hex characters (32 bytes).
# Generate with: openssl rand -hex 32
MESSAGE_ENCRYPTION_KEY=

# ── Email (SMTP) — leave SMTP_USER/PASS empty to disable email sending ─────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
