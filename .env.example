# =============================================================================
# .env — Production environment для VPS survey-pulse.avalon.exposed
# =============================================================================
# ВАЖЛИВО: НЕ коміть цей файл у Git!
# Переконайтесь що .env є у .gitignore
# =============================================================================

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ── CORS — дозволяємо запити ЛИШЕ з нашого домену ────────────────────────────
FRONTEND_URL=https://survey-pulse.avalon.exposed

# ── Auth Secrets — ЗМІНІТЬ НА ВЛАСНІ! ────────────────────────────────────────
# Генерувати: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=ЗАМІНІТЬ_ЦЕ_НА_МІНІМУМ_64_СИМВОЛИ_ВИПАДКОВОГО_РЯДКА_1
COOKIE_SECRET=ЗАМІНІТЬ_ЦЕ_НА_МІНІМУМ_64_СИМВОЛИ_ВИПАДКОВОГО_РЯДКА_2

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
# Ім'я сервісу "postgres" — це DNS-ім'я всередині Docker-мережі
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ЗАМІНІТЬ_НА_СИЛЬНИЙ_ПАРОЛЬ_БД
POSTGRES_DB=survey_db

DATABASE_URL=postgresql://postgres:ЗАМІНІТЬ_НА_СИЛЬНИЙ_ПАРОЛЬ_БД@postgres:5432/survey_db?schema=public

# pg_isready у entrypoint.sh використовує ці змінні
PGHOST=postgres
PGUSER=postgres
PGPASSWORD=ЗАМІНІТЬ_НА_СИЛЬНИЙ_ПАРОЛЬ_БД
PGDATABASE=survey_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Rate Limiting (vote endpoint) ─────────────────────────────────────────────
# Максимум 5 голосувань за 60 секунд з одного джерела
RATE_LIMIT_VOTES=5
RATE_LIMIT_WINDOW_S=60

# ── Admin (для seed скрипту — не обов'язково для рантайму) ────────────────────
ADMIN_EMAIL=admin@survey-pulse.avalon.exposed
ADMIN_PASSWORD=ЗАМІНІТЬ_НА_СКЛАДНИЙ_ПАРОЛЬ_АДМІНА
